# CodeMentor AI - API Keys (copy to .env and fill in your keys)
# Get Groq key: https://console.groq.com/
# Get Gemini key: https://aistudio.google.com/

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB (session history) — Atlas or local
# https://www.mongodb.com/docs/atlas/getting-started/
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB=codementor_ai

# Legacy alias (optional)
# MONGO_URI=your_mongodb_connection_string_here
# MONGO_DB=codementor_ai
